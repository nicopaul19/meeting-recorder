# ========================================
# Meeting Recorder — Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!
# ========================================

# OpenAI API Key (required for transcription with gpt-4o-transcribe)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Notion Integration Token (required for pushing meeting notes)
# Create at: https://www.notion.so/my-integrations
NOTION_TOKEN=

# Notion Database ID for your meeting notes
# Find in your Notion DB URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DB_MEETINGS_ID=

# Google Calendar OAuth Setup
# 1. Go to https://console.cloud.google.com/
# 2. Enable the Google Calendar API
# 3. Create OAuth 2.0 credentials (Desktop app)
# 4. Download credentials.json and place it in this directory
# 5. On first run, a browser window will open for authorization
